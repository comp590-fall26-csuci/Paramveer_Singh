[0.830, "o", "\u001b[47D\u001b[27ms\u001b[27ms\u001b[27mh\u001b[27m \u001b[27mb\u001b[27ma\u001b[27mn\u001b[27md\u001b[27mi\u001b[27mt\u001b[27m4\u001b[27m@\u001b[27mb\u001b[27ma\u001b[27mn\u001b[27md\u001b[27mi\u001b[27mt\u001b[27m.\u001b[27ml\u001b[27ma\u001b[27mb\u001b[27ms\u001b[27m.\u001b[27mo\u001b[27mv\u001b[27me\u001b[27mr\u001b[27mt\u001b[27mh\u001b[27me\u001b[27mw\u001b[27mi\u001b[27mr\u001b[27me\u001b[27m.\u001b[27mo\u001b[27mr\u001b[27mg\u001b[27m \u001b[27m-\u001b[27mp\u001b[27m \u001b[27m2\u001b[27m2\u001b[27m2\u001b[27m0\u001b[?2004l\r\r\n"]
