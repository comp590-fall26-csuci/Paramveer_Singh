[15.882, "o", "\u001b[7mcat > lab1.py << 'EOF'\u001b[27m\r\r\n\u001b[7mdef fib_iterative(n, path):\u001b[27m\u001b[K\r\r\n\u001b[7m    with open(path, \"w\") as f:\u001b[27m\u001b[K\r\r\n\u001b[7m        a, b = 0, 1\u001b[27m\u001b[K\r\r\n\u001b[7m        for _ in range(n):\u001b[27m\u001b[K\r\r\n\u001b[7m            f.write(f\"{a}\\n\")\u001b[27m\u001b[K\r\r\n\u001b[7m            a, b = b, a + b\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mif __name__ == \"__main__\":\u001b[27m\u001b[K\r\r\n\u001b[7m    fib_iterative(25, \"output/fibonacci.txt\")\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K\r\r\n\u001b[K"]
[1.003, "o", "\u001b[12A\u001b[58C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m>\u001b[27m \u001b[27ml\u001b[27ma\u001b[27mb\u001b[27m1\u001b[27m.\u001b[27mp\u001b[27my\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[1B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mb\u001b[27m_\u001b[27mi\u001b[27mt\u001b[27me\u001b[27mr\u001b[27ma\u001b[27mt\u001b[27mi\u001b[27mv\u001b[27me\u001b[27m(\u001b[27mn\u001b[27m,\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mw\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27m \u001b[27mo\u001b[27mp\u001b[27me\u001b[27mn\u001b[27m(\u001b[27mp\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27m,\u001b[27m \u001b[27m\"\u001b[27mw\u001b[27m\"\u001b[27m)\u001b[27m \u001b[27ma\u001b[27ms\u001b[27m \u001b[27mf\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27ma\u001b[27m,\u001b[27m \u001b[27mb\u001b[27m \u001b[27m=\u001b[27m \u001b[27m0\u001b[27m,\u001b[27m \u001b[27m1\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b[27mr\u001b[27m \u001b[27m_\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27mr\u001b[27ma\u001b[27mn\u001b[27mg\u001b[27me\u001b[27m(\u001b[27mn\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[29P\u001b[12Cf.write(f\"{a}\\n\")\u001b[62C\u001b[K\u001b[1B\r\u001b[27P\u001b[12Ca, b = b, a + b\u001b[66C\u001b[K\u001b[3B\r\u001b[27mi\u001b[27mf\u001b[27m \u001b[27m_\u001b[27m_\u001b[27mn\u001b[27ma\u001b[27mm\u001b[27me\u001b[27m_\u001b[27m_\u001b[27m \u001b[27m=\u001b[27m=\u001b[27m \u001b[27m\"\u001b[27m_\u001b[27m_\u001b[27mm\u001b[27ma\u001b[27mi\u001b[27mn\u001b[27m_\u001b[27m_\u001b[27m\"\u001b[27m:\u001b[1B\r\u001b[27m "]
