[0.806, "o", "\u001b[A\u001b[45C\u001b[27mg\u001b[27mi\u001b[27mt\u001b[27m \u001b[27mc\u001b[27mo\u001b[27mm\u001b[27mm\u001b[27mi\u001b[27mt\u001b[27m \u001b[27m-\u001b[27mm\u001b[27m \u001b[27m\"\u001b[27mA\u001b[27md\u001b[27md\u001b[27m \u001b[27mi\u001b[27mt\u001b[27me\u001b[27mr\u001b[27ma\u001b[27mt\u001b[27mi\u001b[27mv\u001b[27me\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mb\u001b[27mo\u001b[27mn\u001b[27ma\u001b[27mc\u001b[27mc\u001b[27mi\u001b[27m \u001b[27mw\u001b[27mr\u001b[27mi\u001b[27mt\u001b[27mi\u001b[27mn\u001b[27mg\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mr\u001b[27ms\u001b[27mt\u001b[27m \u001b[27m2\u001b[27m5\u001b[27m \u001b[27mn\u001b[27mu\u001b[27mm\u001b[27mb\u001b[27me\u001b[27mrs\u001b[27m \u001b[27mt\u001b[27mo\u001b[27m \u001b[27mo\u001b[27mu\u001b[27mt\u001b[27mp\u001b[27mu\u001b[27mt\u001b[27m/\u001b[27m\""]
