[10.333, "o", "\u001b[7mcat > lab1.py << 'EOF'\u001b[27m\r\r\n\u001b[7mdef fib(n):\u001b[27m\u001b[K\r\r\n\u001b[7m    if n < 2:\u001b[27m\u001b[K\r\r\n\u001b[7m        return n\u001b[27m\u001b[K\r\r\n\u001b[7m    return fib(n - 1) + fib(n - 2)\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mdef fib_recursive(n, path):\u001b[27m\u001b[K\r\r\n\u001b[7m    with open(path, \"w\") as f:\u001b[27m\u001b[K\r\r\n\u001b[7m        for i in range(n):\u001b[27m\u001b[K\r\r\n\u001b[7m            f.write(f\"{fib(i)}\\n\")\u001b[27m\u001b[K\r\r\n\u001b[K\r\r\n\u001b[K\r\r\n\u001b[7mif __name__ == \"__main__\":\u001b[27m\u001b[K\r\r\n\u001b[7m    fib_recursive(25, \"output/fibonacci.txt\")\u001b[27m\u001b[K\r\r\n\u001b[7mEOF\u001b[27m\u001b[K"]
[0.313, "o", "\u001b[15A\u001b[55C\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27m \u001b[27m>\u001b[27m \u001b[27ml\u001b[27ma\u001b[27mb\u001b[27m1\u001b[27m.\u001b[27mp\u001b[27my\u001b[27m \u001b[27m<\u001b[27m<\u001b[27m \u001b[27m'\u001b[27mE\u001b[27mO\u001b[27mF\u001b[27m'\u001b[1B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mb\u001b[27m(\u001b[27mn\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mi\u001b[27mf\u001b[27m \u001b[27mn\u001b[27m \u001b[27m<\u001b[27m \u001b[27m2\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[27m \u001b[27mn\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mr\u001b[27me\u001b[27mt\u001b[27mu\u001b[27mr\u001b[27mn\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mb\u001b[27m(\u001b[27mn\u001b[27m \u001b[27m-\u001b[27m \u001b[27m1\u001b[27m)\u001b[27m \u001b[27m+\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mb\u001b[27m(\u001b[27mn\u001b[27m \u001b[27m-\u001b[27m \u001b[27m2\u001b[27m)\u001b[3B\r\u001b[27md\u001b[27me\u001b[27mf\u001b[27m \u001b[27mf\u001b[27mi\u001b[27mb\u001b[27m_\u001b[27mr\u001b[27me\u001b[27mc\u001b[27mu\u001b[27mr\u001b[27ms\u001b[27mi\u001b[27mv\u001b[27me\u001b[27m(\u001b[27mn\u001b[27m,\u001b[27m \u001b[27mp\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mw\u001b[27mi\u001b[27mt\u001b[27mh\u001b[27m \u001b[27mo\u001b[27mp\u001b[27me\u001b[27mn\u001b[27m(\u001b[27mp\u001b[27ma\u001b[27mt\u001b[27mh\u001b[27m,\u001b[27m \u001b[27m\"\u001b[27mw\u001b[27m\"\u001b[27m)\u001b[27m \u001b[27ma\u001b[27ms\u001b[27m \u001b[27mf\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mo\u001b"]
[0.000, "o", "[27mr\u001b[27m \u001b[27mi\u001b[27m \u001b[27mi\u001b[27mn\u001b[27m \u001b[27mr\u001b[27ma\u001b[27mn\u001b[27mg\u001b[27me\u001b[27m(\u001b[27mn\u001b[27m)\u001b[27m:\u001b[1B\r\u001b[34P\u001b[12Cf.write(f\"{fib(i)}\\n\")\u001b[52C\u001b[K\u001b[3B\r\u001b[27mi\u001b[27mf\u001b[27m \u001b[27m_\u001b[27m_\u001b[27mn\u001b[27ma\u001b[27mm\u001b[27me\u001b[27m_\u001b[27m_\u001b[27m \u001b[27m=\u001b[27m=\u001b[27m \u001b[27m\"\u001b[27m_\u001b[27m_\u001b[27mm\u001b[27ma\u001b[27mi\u001b[27mn\u001b[27m_\u001b[27m_\u001b[27m\"\u001b[27m:\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27mf\u001b[27mi\u001b[27mb\u001b[27m_\u001b[27mr\u001b[27me\u001b[27mc\u001b[27mu\u001b[27mr\u001b[27ms\u001b[27mi\u001b[27mv\u001b[27me\u001b[27m(\u001b[27m2\u001b[27m5\u001b[27m,\u001b[27m \u001b[27m\"\u001b[27mo\u001b[27mu\u001b[27mt\u001b[27mp\u001b[27mu\u001b[27mt\u001b[27m/\u001b[27mf\u001b[27mi\u001b[27mb\u001b[27mo\u001b[27mn\u001b[27ma\u001b[27mc\u001b[27mc\u001b[27mi\u001b[27m.\u001b[27mt\u001b[27mx\u001b[27mt\u001b[27m\"\u001b[27m)\u001b[1B\r\u001b[27mE\u001b[27mO\u001b[27mF"]
